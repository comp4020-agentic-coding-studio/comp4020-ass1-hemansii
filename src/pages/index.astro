---
import Layout from "../layouts/Layout.astro";
---

<Layout title="F1 wing angle explainer">
  <nav aria-label="Primary">
    <a href="./">Home</a>
  </nav>
  <header>
    <h1>How much wing does an F1 car need?</h1>
    <p>
      More rear wing angle means more downforce and more grip through corners
      — but more drag, so a lower top speed on the straights. Push it past the
      point where the wing stalls and you lose both at once.
    </p>
  </header>
  <main>
    <section class="chart-section" aria-labelledby="chart-heading">
      <h2 id="chart-heading">Corner speed and top speed vs. wing angle</h2>

      <svg class="angle-chart" viewBox="0 0 600 300" data-testid="angle-chart" aria-hidden="true">
        <line class="stall-line" data-testid="stall-line"></line>
        <text class="stall-label" data-testid="stall-label">stall</text>
        <path class="corner-speed-path" data-testid="corner-speed-path"></path>
        <path class="top-speed-path" data-testid="top-speed-path"></path>
        <line class="marker-line" data-testid="angle-marker-line"></line>
        <circle class="corner-speed-marker" data-testid="corner-speed-marker" r="4"></circle>
        <circle class="top-speed-marker" data-testid="top-speed-marker" r="4"></circle>
      </svg>

      <p class="chart-legend">
        <span class="legend-item corner">Corner speed</span>
        <span class="legend-item top">Top speed</span>
      </p>

      <div class="slider-row">
        <span class="slider-end-label" aria-hidden="true">0°</span>
        <input
          type="range"
          id="wing-angle"
          data-testid="wing-angle-slider"
          min="0"
          max="30"
          step="1"
          value="9"
        />
        <span class="slider-end-label" aria-hidden="true">30°</span>
      </div>
      <label for="wing-angle" class="slider-label">Rear wing angle</label>
    </section>

    <section class="car-section" aria-labelledby="car-heading">
      <h2 id="car-heading">What the wing angle looks like</h2>

      <svg class="car-scene" viewBox="0 0 600 220" data-testid="car-scene" aria-hidden="true">
        <path
          class="chassis"
          d="M 580 182
             L 530 190
             L 505 193
             L 415 193
             L 390 160
             L 350 130
             L 310 130
             L 270 145
             L 230 175
             L 210 193
             L 100 193
             L 95 185
             L 95 196
             L 580 196
             Z"
        ></path>
        <path class="halo" d="M 302 131 Q 330 98 358 131"></path>
        <circle class="wheel" cx="460" cy="162" r="34"></circle>
        <circle class="wheel" cx="150" cy="158" r="38"></circle>

        <rect class="wing-strut" x="97" y="112" width="6" height="66"></rect>
        <g class="rear-wing" data-testid="rear-wing">
          <path
            class="airflow-line"
            data-testid="airflow-line-1"
          ></path>
          <path
            class="airflow-line"
            data-testid="airflow-line-2"
          ></path>
          <rect class="wing-plane" x="20" y="109" width="80" height="6"></rect>
          <rect class="wing-endplate" x="16" y="92" width="5" height="40"></rect>
          <rect class="wing-endplate" x="95" y="97" width="5" height="30"></rect>
        </g>
      </svg>

      <p class="car-caption">
        The rear wing tilts to the angle set by the slider above — flat at 0°,
        steepest at 30°. Airflow over the wing stays smooth until the wing
        stalls, then breaks up.
      </p>
    </section>

    <div class="stat-grid">
      <div class="stat">
        <span class="stat-label">Downforce</span>
        <output for="wing-angle" data-testid="downforce-value" class="stat-value"></output>
      </div>
      <div class="stat">
        <span class="stat-label">Drag coefficient</span>
        <output for="wing-angle" data-testid="drag-value" class="stat-value"></output>
      </div>
      <div class="stat">
        <span class="stat-label">Corner speed</span>
        <output for="wing-angle" data-testid="corner-speed-value" class="stat-value"></output>
      </div>
      <div class="stat">
        <span class="stat-label">Top speed</span>
        <output for="wing-angle" data-testid="top-speed-value" class="stat-value"></output>
      </div>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
